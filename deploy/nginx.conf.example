# Include under nginx's http block on the host. Replace the domain/cert paths.
# This is ONE edge TLS proxy, not a chain behind another proxy/CDN.
# Do not log query strings, credentials or signed URLs.
log_format api_safe '$request_method $status $request_time';
server {
    listen 80;
    server_name api.example.com;
    return 308 https://api.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name api.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    access_log /var/log/nginx/api-access.log api_safe;
    # Leaves room for multipart framing around the 5 MiB application file cap.
    client_max_body_size 6m;
    client_body_timeout 30s;
    proxy_read_timeout 65s;
    # Probes are for the container/LB, not a public dependency diagnostic.
    location /health/ { return 404; }
    location /media/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host api.example.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_request_buffering on;
        # No proxy_cache for authenticated APIs or private files.
    }
}

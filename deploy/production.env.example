# Copy OUTSIDE the repository to an owner-readable file, mode 600.
# Docker/Compose raw env syntax: unquoted literal values, no shell expansion.
DJANGO_SETTINGS_MODULE=settings.production
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=api.example.com
POSTGRES_DB=django_api
POSTGRES_USER=django_api
POSTGRES_PASSWORD=
POSTGRES_HOST=db.internal.example.com
POSTGRES_PORT=5432
# verify-full checks both CA and hostname. Mount a CA bundle if required.
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=

# Enable ONLY when a trusted TLS proxy overwrites X-Forwarded-Proto and the
# application is unreachable except through that proxy and trusted operators.
TRUST_PROXY_SSL_HEADER=False
# X-Forwarded-For trust is separate: set 1 only for one sanitizing edge proxy.
API_NUM_PROXIES=0
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=60
WEB_GRACEFUL_TIMEOUT=30
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False

PRIVATE_FILE_BACKEND=filesystem
PRIVATE_FILE_MAX_BYTES=5242880
PRIVATE_FILE_RATE_LIMIT=20
PRIVATE_FILE_PENDING_SECONDS=3600
PRIVATE_FILE_RECHECK_SECONDS=3600
PRIVATE_FILE_SIGNED_DOWNLOADS=False
PRIVATE_FILE_URL_TTL=60
# For S3 use runtime-storage or runtime-full, then set bucket and credentials
# through your workload identity or secret provider. Do not enable a public ACL.
PRIVATE_FILE_S3_BUCKET=
PRIVATE_FILE_S3_ENDPOINT=
PRIVATE_FILE_S3_REGION=us-east-1
PRIVATE_FILE_S3_ALLOW_HTTP=False

PERFORMANCE_CACHE_BACKEND=django.core.cache.backends.dummy.DummyCache
# Required only with async/Redis/S3 combinations; see image matrix in the guide.
# PERFORMANCE_CACHE_LOCATION=rediss://cache.internal.example.com:6379/1
# RABBITMQ_URL=amqps://...
# REDIS_URL=rediss://...

# SMTP is optional until the application needs email.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Django
DJANGO_SETTINGS_MODULE=settings.local
DEBUG=True
SECRET_KEY=django-insecure-local-development-only
LOG_LEVEL=INFO

# Database
POSTGRES_DB=django_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API security
# Keep 0 unless the app is behind exactly N trusted proxies that sanitize X-Forwarded-For.
API_NUM_PROXIES=0
AUTH_LOGIN_IP_RATE_LIMIT=20
AUTH_LOGIN_CREDENTIAL_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=60

# Private files (local filesystem; never publish this directory).
PRIVATE_FILE_BACKEND=filesystem
# Default root is <BASE_DIR>/private-files. Set an absolute path when overriding.
# PRIVATE_FILE_ROOT=/srv/django/private-files
PRIVATE_FILE_MAX_BYTES=5242880
PRIVATE_FILE_RATE_LIMIT=20
PRIVATE_FILE_PENDING_SECONDS=3600
PRIVATE_FILE_RECHECK_SECONDS=3600
PRIVATE_FILE_SIGNED_DOWNLOADS=False
PRIVATE_FILE_URL_TTL=60
# Optional S3 requires the existing storage extra and a pre-provisioned private bucket.
PRIVATE_FILE_S3_BUCKET=
PRIVATE_FILE_S3_ENDPOINT=
PRIVATE_FILE_S3_REGION=us-east-1
PRIVATE_FILE_S3_ALLOW_HTTP=False
# Credentials come from workload identity or securely injected AWS_* variables.
# Schedule reconcile_private_files + dispatch_outbox with the SAME storage config.

# Opt-in read-model caching (disabled by default; unrelated to auth/throttles).
PERFORMANCE_CACHE_BACKEND=django.core.cache.backends.dummy.DummyCache
PERFORMANCE_CACHE_LOCATION=read-models
PERFORMANCE_CACHE_KEY_PREFIX=django-api-starter-local
# For single-process development: django.core.cache.backends.locmem.LocMemCache
# For shared Redis: django.core.cache.backends.redis.RedisCache
# Set LOCATION=redis://redis:6379/1, install the async extra, and provision Redis.
# Do not reuse Celery's result database or a production cache for tests.

# Durable background work / outbox
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=3600
OUTBOX_MAX_EVENT_BYTES=65536

# Outbound webhooks
# Required in production. Generate independently and provision receiver secrets
# through your secret-management workflow; signing material is never returned by API.
WEBHOOK_SIGNING_MASTER_KEY=
WEBHOOK_BATCH_SIZE=100
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_RETRY_MAX_SECONDS=3600
WEBHOOK_HTTP_TIMEOUT_SECONDS=5
WEBHOOK_ALLOWED_PORTS=443
WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=False

# Notifications
DEFAULT_FROM_EMAIL=webmaster@localhost
NOTIFICATION_EMAIL_PROVIDER=apps.notifications.provider.DjangoMailerEmailProvider
NOTIFICATION_MAILER_ALIAS=default
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600

# Optional async profile
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672/

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Sentry (opt-in)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
